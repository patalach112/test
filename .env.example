# Local accounts work by default; no separate auth service is needed.
# SQLite is stored outside Git. Back up the database regularly.
AUTH_DB_PATH=./data/firmwarewatch.sqlite

# For Cloudflare Tunnel production hosting, uncomment this on YOUR host:
# APP_ORIGIN=https://firmwarewatch.com
# Keep unset for localhost development and Arena previews.

# OPTIONAL: use an existing external identity API instead of SQLite.
# Never use NEXT_PUBLIC_ for these values. See the integration docs.
AUTH_API_URL=
AUTH_LOGIN_PATH=auth/login
AUTH_REGISTER_PATH=auth/register
AUTH_ME_PATH=auth/me
AUTH_LOGOUT_PATH=auth/logout
AUTH_RESET_PATH=auth/password-reset
